# ── Database ──────────────────────────────────────────────────
# A single DATABASE_URL works everywhere — local Docker Postgres, Supabase,
# or Railway's injected Postgres URL. Any scheme (postgres://, postgresql://,
# postgresql+asyncpg://) is normalized automatically (see app/core/config.py).
#
# Local (docker-compose):
DATABASE_URL=postgresql+asyncpg://scribe:scribe@localhost:5432/thescribe
#
# Railway example (Railway injects this automatically when you add a Postgres
# service and reference it as ${{Postgres.DATABASE_URL}} in your service vars):
# DATABASE_URL=postgresql://postgres:password@containers-us-west-1.railway.app:5432/railway
#
# Supabase example:
# DATABASE_URL=postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres

# ── Supabase (optional — only needed if using Supabase Storage/Auth directly) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# ── LLM Provider ─────────────────────────────────────────────
# "rotate"    = (default) rotates across local/free-cloud Ollama models,
#                then Groq's free tier, then Anthropic as a last-resort
#                fallback — tries each in order, skips anything currently
#                rate-limited/erroring, fails over silently between them.
#                Costs nothing until it actually has to fall through to
#                Anthropic, and never goes down just because one provider
#                is rate-limited.
# "anthropic" = pin to Claude Sonnet 4 only, no rotation — recommended for
#                a final demo/submission where you want guaranteed-consistent
#                output quality.
# "groq"      = pin to Groq only, no rotation — useful for isolating it
#                while debugging.
# Swap modes without touching any code — just change this value and restart.
LLM_PROVIDER=rotate

ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

GROQ_API_KEY=gsk_your-groq-key-here
# First model tried on Groq under "rotate" or "groq" — rotate mode also
# falls back to openai/gpt-oss-20b and qwen/qwen3.6-27b if this one is
# rate-limited or erroring (see backend/app/services/ai/llm_client.py).
GROQ_MODEL=openai/gpt-oss-120b

# Local Ollama server for the "rotate" pool. Leave enabled even without
# Ollama installed — discovery just fails fast and rotation moves on to
# Groq/Anthropic. Also picks up Ollama's free cloud-hosted models
# (e.g. gpt-oss:120b-cloud) if you've pulled them.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434

# Google Sign-In (optional). Use the OAuth 2.0 Web client ID from Google Cloud.
# This is public and must match VITE_GOOGLE_CLIENT_ID in the frontend host.
GOOGLE_CLIENT_ID=1234567890-your-client-id.apps.googleusercontent.com

# ── JWT ───────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Redis (for Dramatiq background jobs) ────────────────────
# Local (docker-compose):
REDIS_URL=redis://localhost:6379/0
# Railway: reference ${{Redis.REDIS_URL}} after adding the Redis plugin.

# ── Embeddings ────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── App ───────────────────────────────────────────────────────
# "development" or "production". In production, validate_for_startup() will
# raise if SECRET_KEY is still the default placeholder.
ENVIRONMENT=development

# JSON array of allowed frontend origins.
CORS_ORIGINS=["http://localhost:5173"]

# Railway injects PORT automatically — only needed locally if you want a
# non-default port for `uvicorn app.main:app --port $PORT`.
PORT=8000
